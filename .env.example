# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string. Locally: postgres://user:pass@localhost:5432/kist
DATABASE_URL=

# Used only by the test suite (a separate, disposable database)
TEST_DATABASE_URL=

# 32+ random characters, used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Password given to every demo account when you run the seed script
DEMO_PASSWORD=

# true = show demo shortcuts on the sign-in page and allow the reviewer demo clock
DEMO_MODE=true

# Optional: CA certificate (PEM, newlines as \n) of your managed Postgres, so the
# connection is verified, not just encrypted. Supabase: Settings > Database > SSL.
DATABASE_CA_CERT=

# Optional: connections per server instance (default 5; use 1-3 on serverless)
DATABASE_POOL_MAX=
